import Caddyfile.shared

{$PAPER_DOMAIN:localhost} {
    import paper_security

    handle /_auth/* {
        handle_path /_auth/* {
            reverse_proxy password-gate:8079 {
                header_up X-Paper-Client-IP {http.request.remote.host}
            }
        }
    }

    @public_brand_asset path /favicon.ico /apple-touch-icon.png /site.webmanifest /assets/favicon-64.png /assets/paper-workspace-icon.png /assets/paper-workspace-touch.png /assets/paper-workspace.webmanifest /assets/share-preview-v3.png /assets/inter-variable.woff2
    handle @public_brand_asset {
        reverse_proxy workspace:8080
    }

    handle {
      route {
        request_header -X-Paper-Role
        request_header -X-Paper-Allowed-Projects
        request_header -X-Paper-Actor
        request_header -X-Paper-Client-IP
        forward_auth password-gate:8079 {
            uri /verify
            copy_headers X-Paper-Actor X-Paper-Role X-Paper-Allowed-Projects
            header_up X-Paper-Client-IP {http.request.remote.host}
        }
        @account_catalog path /projects/index.json
        handle @account_catalog {
            rewrite * /catalog
            reverse_proxy password-gate:8079
        }
        @hub path_regexp personal_hub ^/(?:[A-Za-z0-9][A-Za-z0-9_-]{0,63}/?)?$
        handle @hub {
            rewrite * /hub.html
            reverse_proxy workspace:8080
        }
        @project_thumbnail path_regexp project_thumbnail ^/projects/[A-Za-z0-9][A-Za-z0-9_-]{0,63}/thumbnail\.(?:png|jpe?g|webp)$
        handle @project_thumbnail {
            reverse_proxy workspace:8080
        }
        import paper_default_project_route
        @canonical_assets path_regexp canonical_assets ^/projects/aaai27/(.*)$
        handle @canonical_assets {
            rewrite * /project/{re.canonical_assets.1}
            reverse_proxy workspace:8080
        }
        @account_project_asset path_regexp account_project_asset ^/(?:p/([A-Za-z0-9][A-Za-z0-9_-]{0,63})/project|projects/([A-Za-z0-9][A-Za-z0-9_-]{0,63}))/(.*)$
        handle @account_project_asset {
            rewrite * /account-project-sources/{re.account_project_asset.1}{re.account_project_asset.2}/{re.account_project_asset.3}
            reverse_proxy workspace:8080
        }
        import paper_project_routes
        handle /api/rebuttal/* {
            reverse_proxy rebuttal:8020 {
            }
        }
        handle /api/codex {
            reverse_proxy codex-bridge:8790 {
                header_up Authorization "Bearer {$CODEX_BRIDGE_TOKEN}"
            }
        }
        handle_path /api/backups/* {
            reverse_proxy backup:8010 {
            }
        }
        handle_path /api/* {
            reverse_proxy compiler:8000 {
            }
        }
        handle /collab-runtime/* {
            reverse_proxy collaboration:8765 {
            }
        }
        handle /collab* {
            reverse_proxy collaboration:8765 {
            }
        }
        reverse_proxy workspace:8080
      }
    }

    handle_errors {
        @unauthorized expression `{http.error.status_code} == 401`
        redir @unauthorized /_auth/login?rd={http.request.uri} 302
    }
}
